<Page x:Class="D365Assistant.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#080C12">

    <Page.Resources>

        <!-- ── Cores base ─────────────────────────────────────────────────── -->
        <!-- bg:       #080C12  surface:  #0F1520  border:   #1E2633        -->
        <!-- accent:   #3B82F6  success:  #22C55E  warn:     #F59E0B        -->
        <!-- danger:   #EF4444  text:     #E2E8F0  muted:    #4B5563        -->

        <!-- ── Botão de filtro (pill) ─────────────────────────────────────── -->
        <Style x:Key="FilterBtn" TargetType="Button">
            <Setter Property="Background"       Value="#0F1520"/>
            <Setter Property="Foreground"       Value="#6B7280"/>
            <Setter Property="BorderBrush"      Value="#1E2633"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="FontFamily"       Value="Segoe UI Semibold"/>
            <Setter Property="Padding"          Value="10,4,10,4"/>
            <Setter Property="Margin"           Value="0,0,5,0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"   Value="#1A2233"/>
                                <Setter TargetName="Bd" Property="BorderBrush"  Value="#3B82F6"/>
                                <Setter Property="Foreground"                   Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Botão de ação primário ────────────────────────────────────── -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"       Value="#1D4ED8"/>
            <Setter Property="Foreground"       Value="#EFF6FF"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FontFamily"       Value="Segoe UI Semibold"/>
            <Setter Property="Padding"          Value="14,7,14,7"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Card KPI ──────────────────────────────────────────────────── -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background"      Value="#0F1520"/>
            <Setter Property="BorderBrush"     Value="#1E2633"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="16,12,16,12"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="MinWidth"        Value="100"/>
        </Style>

        <!-- ── Separador horizontal ──────────────────────────────────────── -->
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Background"  Value="#1E2633"/>
            <Setter Property="Height"      Value="1"/>
        </Style>

        <!-- ── Scroll bar slim ───────────────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2D3748"
                                                        CornerRadius="2"
                                                        Margin="1,0,1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- KPIs      -->
            <RowDefinition Height="Auto"/>
            <!-- Divider   -->
            <RowDefinition Height="Auto"/>
            <!-- Filtros   -->
            <RowDefinition Height="Auto"/>
            <!-- Divider   -->
            <RowDefinition Height="*"/>
            <!-- Lista     -->
        </Grid.RowDefinitions>

        <!-- ══ KPIs ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#080C12"
                Padding="20,16,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Métricas -->
                <WrapPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">

                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="ATIVOS"
                                       FontSize="10" FontFamily="Segoe UI Semibold"
                                       Foreground="#374151"
                                       Margin="0,0,0,6"
                                       />
                            <TextBlock x:Name="KpiTotal"
                                       Text="0"
                                       FontSize="28" FontFamily="Segoe UI Light"
                                       Foreground="#E2E8F0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="6" Height="6"
                                         Fill="#EF4444"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0"/>
                                <TextBlock Text="URGENTE"
                                           FontSize="10" FontFamily="Segoe UI Semibold"
                                           Foreground="#374151"
                                           />
                            </StackPanel>
                            <TextBlock x:Name="KpiUrgente"
                                       Text="0"
                                       FontSize="28" FontFamily="Segoe UI Light"
                                       Foreground="#FCA5A5"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="6" Height="6"
                                         Fill="#F59E0B"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0"/>
                                <TextBlock Text="ALTA PRIOR."
                                           FontSize="10" FontFamily="Segoe UI Semibold"
                                           Foreground="#374151"
                                           />
                            </StackPanel>
                            <TextBlock x:Name="KpiHigh"
                                       Text="0"
                                       FontSize="28" FontFamily="Segoe UI Light"
                                       Foreground="#FCD34D"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="6" Height="6"
                                         Fill="#F59E0B"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0"/>
                                <TextBlock Text="RISCO SLA"
                                           FontSize="10" FontFamily="Segoe UI Semibold"
                                           Foreground="#374151"
                                           />
                            </StackPanel>
                            <TextBlock x:Name="KpiSla"
                                       Text="0"
                                       FontSize="28" FontFamily="Segoe UI Light"
                                       Foreground="#FCD34D"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="6" Height="6"
                                         Fill="#EF4444"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0"/>
                                <TextBlock Text="HS ESGOTADAS"
                                           FontSize="10" FontFamily="Segoe UI Semibold"
                                           Foreground="#374151"
                                           />
                            </StackPanel>
                            <TextBlock x:Name="KpiEsgotado"
                                       Text="0"
                                       FontSize="28" FontFamily="Segoe UI Light"
                                       Foreground="#FCA5A5"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource KpiCard}" Margin="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="6" Height="6"
                                         Fill="#22C55E"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0"/>
                                <TextBlock Text="NOVOS HOJE"
                                           FontSize="10" FontFamily="Segoe UI Semibold"
                                           Foreground="#374151"
                                           />
                            </StackPanel>
                            <TextBlock x:Name="KpiNew"
                                       Text="0"
                                       FontSize="28" FontFamily="Segoe UI Light"
                                       Foreground="#86EFAC"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Ações direita -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="16,0,0,0">
                    <TextBlock x:Name="LastUpdatedText"
                               Text=""
                               FontSize="10"
                               FontFamily="Segoe UI"
                               Foreground="#374151"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,8"/>
                    <Button x:Name="BtnRefresh"
                            Content="↻  Atualizar"
                            Style="{StaticResource ActionBtn}"
                            Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Divider -->
        <Border Grid.Row="1" Style="{StaticResource Divider}"/>

        <!-- ══ FILTROS ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#080C12"
                Padding="20,12,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filtros esquerda -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Text="PRIORIDADE"
                                   FontSize="10" FontFamily="Segoe UI Semibold"
                                   Foreground="#374151"
                                   
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <WrapPanel x:Name="PriFilterPanel" Orientation="Horizontal"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="STATUS   "
                                   FontSize="10" FontFamily="Segoe UI Semibold"
                                   Foreground="#374151"
                                   
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <WrapPanel x:Name="StatusFilterPanel" Orientation="Horizontal"/>
                    </StackPanel>
                </StackPanel>

                <!-- Busca direita -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="IncidentCountText"
                               Text=""
                               FontSize="11"
                               FontFamily="Segoe UI"
                               Foreground="#374151"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>
                    <Border Background="#0F1520"
                            BorderBrush="#1E2633"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Ícone lupa -->
                            <TextBlock Grid.Column="0"
                                       Text="⌕"
                                       FontSize="14"
                                       Foreground="#374151"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                            <TextBox Grid.Column="1"
                                     x:Name="SearchBox"
                                     Background="Transparent"
                                     Foreground="#E2E8F0"
                                     BorderThickness="0"
                                     FontSize="12"
                                     FontFamily="Segoe UI"
                                     Padding="8,7,10,7"
                                     Width="190"
                                     CaretBrush="#3B82F6"
                                     SelectionBrush="#1D4ED8"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Divider -->
        <Border Grid.Row="3" Style="{StaticResource Divider}"/>

        <!-- ══ LISTA DE CHAMADOS ══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                      Background="#080C12"
                      Padding="0,8,0,20">
            <ListBox x:Name="IncidentList"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="20,0,20,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding"                   Value="0"/>
                        <Setter Property="Margin"                    Value="0,0,0,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background"                Value="Transparent"/>
                        <Setter Property="BorderThickness"           Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </ScrollViewer>

    </Grid>
</Page>
