<!-- =============================================================================
     App/Views/VaultDialogs.xaml — Templates de estilo compartilhados pelos diálogos
     Os diálogos em si continuam sendo Window criadas via code-behind,
     mas compartilham este ResourceDictionary para manter consistência visual.
============================================================================= -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ Cores base ══════════════════════════════════════════════════════════ -->
    <Color x:Key="ClrBg">#0B1018</Color>
    <Color x:Key="ClrBgDeep">#06090E</Color>
    <Color x:Key="ClrBorder">#0D1825</Color>
    <Color x:Key="ClrTextPri">#C8DCF0</Color>
    <Color x:Key="ClrTextSec">#3D4E63</Color>
    <Color x:Key="ClrBlue">#1A6CF5</Color>
    <Color x:Key="ClrBtnBg">#0F2A5C</Color>
    <Color x:Key="ClrBtnFg">#5A9FE0</Color>
    <Color x:Key="ClrAmber">#D4830A</Color>

    <SolidColorBrush x:Key="BrushBg"      Color="{StaticResource ClrBg}"/>
    <SolidColorBrush x:Key="BrushBgDeep"  Color="{StaticResource ClrBgDeep}"/>
    <SolidColorBrush x:Key="BrushBorder"  Color="{StaticResource ClrBorder}"/>
    <SolidColorBrush x:Key="BrushTextPri" Color="{StaticResource ClrTextPri}"/>
    <SolidColorBrush x:Key="BrushTextSec" Color="{StaticResource ClrTextSec}"/>
    <SolidColorBrush x:Key="BrushBlue"    Color="{StaticResource ClrBlue}"/>
    <SolidColorBrush x:Key="BrushAmber"   Color="{StaticResource ClrAmber}"/>

    <!-- ══ Estilo: janela de diálogo ══════════════════════════════════════════ -->
    <Style x:Key="DlgWindow" TargetType="Window">
        <Setter Property="Background"  Value="{StaticResource BrushBg}"/>
        <Setter Property="ResizeMode"  Value="NoResize"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
    </Style>

    <!-- ══ Estilo: rótulo de seção ════════════════════════════════════════════ -->
    <Style x:Key="DlgTitle" TargetType="TextBlock">
        <Setter Property="FontSize"     Value="15"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Foreground"  Value="{StaticResource BrushTextPri}"/>
        <Setter Property="Margin"      Value="0,0,0,18"/>
    </Style>

    <!-- ══ Estilo: label de campo ════════════════════════════════════════════ -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="11"/>
        <Setter Property="Foreground"  Value="{StaticResource BrushTextSec}"/>
        <Setter Property="Margin"      Value="0,0,0,3"/>
    </Style>

    <!-- ══ Estilo: TextBox de formulário ══════════════════════════════════════ -->
    <Style x:Key="DlgField" TargetType="TextBox">
        <Setter Property="Background"      Value="{StaticResource BrushBgDeep}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="10,7,10,7"/>
        <Setter Property="Margin"          Value="0,0,0,12"/>
        <Setter Property="CaretBrush"      Value="{StaticResource BrushBlue}"/>
        <Setter Property="SelectionBrush"  Value="#0F2A5C"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Estilo: PasswordBox de formulário ══════════════════════════════════ -->
    <Style x:Key="DlgPassword" TargetType="PasswordBox">
        <Setter Property="Background"      Value="{StaticResource BrushBgDeep}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="10,7,10,7"/>
        <Setter Property="Margin"          Value="0,0,0,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Estilo: ComboBox de formulário ════════════════════════════════════ -->
    <Style x:Key="DlgCombo" TargetType="ComboBox">
        <Setter Property="Background"      Value="{StaticResource BrushBgDeep}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="8,6,8,6"/>
        <Setter Property="Margin"          Value="0,0,0,12"/>
        <Setter Property="IsEditable"      Value="True"/>
    </Style>

    <!-- ══ Estilo: botão primário (azul) ══════════════════════════════════════ -->
    <Style x:Key="DlgBtn" TargetType="Button">
        <Setter Property="Background"      Value="#0F2A5C"/>
        <Setter Property="Foreground"      Value="#5A9FE0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontFamily"      Value="Segoe UI Semibold"/>
        <Setter Property="Padding"         Value="20,9,20,9"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A3F80"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0A1E40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Estilo: botão cancelar (ghost) ════════════════════════════════════ -->
    <Style x:Key="DlgBtnCancel" TargetType="Button" BasedOn="{StaticResource DlgBtn}">
        <Setter Property="Background" Value="#12171F"/>
        <Setter Property="Foreground" Value="#3D4E63"/>
    </Style>

    <!-- ══ Separador horizontal ══════════════════════════════════════════════ -->
    <Style x:Key="DlgSep" TargetType="Border">
        <Setter Property="Height"           Value="1"/>
        <Setter Property="Background"       Value="{StaticResource BrushBorder}"/>
        <Setter Property="Margin"           Value="0,4,0,16"/>
    </Style>

    <!-- ══ Aviso laranja ══════════════════════════════════════════════════════ -->
    <Style x:Key="DlgWarning" TargetType="TextBlock">
        <Setter Property="FontSize"        Value="10"/>
        <Setter Property="Foreground"      Value="{StaticResource BrushAmber}"/>
        <Setter Property="Margin"          Value="0,4,0,12"/>
        <Setter Property="TextWrapping"    Value="Wrap"/>
    </Style>

</ResourceDictionary>
