<Page x:Class="D365Assistant.Views.VaultView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#070B10">

    <Page.Resources>

        <!-- ── Botão primário (azul) ──────────────────────────────────────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#0F2A5C"/>
            <Setter Property="Foreground"      Value="#5A9FE0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI Semibold"/>
            <Setter Property="Padding"         Value="14,7,14,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A3F80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A1E40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Botão verde ───────────────────────────────────────────────── -->
        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#0A2A14"/>
            <Setter Property="Foreground" Value="#6EDFA0"/>
        </Style>

        <!-- ── Botão perigo (vermelho sutil) ─────────────────────────────── -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#2A0A0A"/>
            <Setter Property="Foreground" Value="#F08080"/>
        </Style>

        <!-- ── Botão ghost (transparente) ────────────────────────────────── -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#3D4E63"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Padding"         Value="6,4,6,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0E1621"/>
                                <Setter Property="Foreground" Value="#7A9BBF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tab button inativo ────────────────────────────────────────── -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#3D4E63"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Padding"         Value="18,11,18,11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#7A9BBF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tab button ATIVO ──────────────────────────────────────────── -->
        <Style x:Key="TabBtnActive" TargetType="Button" BasedOn="{StaticResource TabBtn}">
            <Setter Property="Foreground" Value="#C8DCF0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="#1A6CF5" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox estilizado ─────────────────────────────────────────── -->
        <Style x:Key="VaultInput" TargetType="TextBox">
            <Setter Property="Background"      Value="#06090E"/>
            <Setter Property="Foreground"      Value="#C8DCF0"/>
            <Setter Property="BorderBrush"     Value="#0D1825"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Padding"         Value="10,7,10,7"/>
            <Setter Property="CaretBrush"      Value="#1A6CF5"/>
            <Setter Property="SelectionBrush"  Value="#0F2A5C"/>
        </Style>

        <!-- ── Card de item (credencial / link) ──────────────────────────── -->
        <Style x:Key="ItemCard" TargetType="Border">
            <Setter Property="Background"      Value="#0B1018"/>
            <Setter Property="BorderBrush"     Value="#0D1825"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,14,16,14"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
        </Style>

        <!-- ── Botão ícone dentro do card ────────────────────────────────── -->
        <Style x:Key="CardIconBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="5,3,5,3"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Slim scrollbar ─────────────────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#1E3A5F" CornerRadius="2" Margin="0,1,0,1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header global  -->
            <RowDefinition Height="Auto"/>
            <!-- Divider        -->
            <RowDefinition Height="*"/>
            <!-- Body           -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0B1018" Padding="22,15,22,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título + status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔐" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Cofre de Credenciais"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="#C8DCF0"
                               VerticalAlignment="Center"/>
                    <!-- Badge de estado do vault -->
                    <Border x:Name="LockBadge"
                            Background="#2A0A0A"
                            CornerRadius="8"
                            Padding="10,3,10,3"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="LockBadgeText"
                                   Text="🔒  Bloqueado"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#F08080"/>
                    </Border>
                    <!-- Mensagem de erro/status inline -->
                    <TextBlock x:Name="StatusMsg"
                               Text=""
                               FontSize="11"
                               Foreground="#F08080"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Ações direita -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAddClient"
                            Content="➕  Cliente"
                            Style="{StaticResource GreenBtn}"
                            Margin="0,0,8,0"
                            Click="BtnAddClient_Click"
                            Visibility="Collapsed"/>
                    <Button x:Name="BtnToggleLock"
                            Content="🔒  Desbloquear"
                            Style="{StaticResource PrimaryBtn}"
                            Click="BtnToggleLock_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#0D1825" Height="1"/>

        <!-- ══ BODY ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <!-- Lista clientes  -->
                <ColumnDefinition Width="1"/>
                <!-- Divisor         -->
                <ColumnDefinition Width="*"/>
                <!-- Detalhe         -->
            </Grid.ColumnDefinitions>

            <!-- ── Painel esquerdo: Clientes ─────────────────────────────── -->
            <DockPanel Grid.Column="0" Background="#0B1018">

                <!-- Busca -->
                <Border DockPanel.Dock="Top"
                        Background="#06090E"
                        BorderBrush="#0D1825"
                        BorderThickness="0,0,0,1"
                        Padding="10,8,10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="⌕" FontSize="14"
                                   Foreground="#1E2E40"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 Background="Transparent"
                                 Foreground="#C8DCF0"
                                 BorderThickness="0"
                                 FontSize="12" FontFamily="Segoe UI"
                                 Padding="0,4,0,4"
                                 CaretBrush="#1A6CF5"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Lista de clientes -->
                <ScrollViewer DockPanel.Dock="Top"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ClientListPanel"/>
                </ScrollViewer>
            </DockPanel>

            <!-- Divisor vertical -->
            <Border Grid.Column="1" Background="#0D1825"/>

            <!-- ── Painel direito: Detalhe ────────────────────────────────── -->
            <Grid Grid.Column="2">

                <!-- Estado: vault bloqueado ou sem seleção -->
                <Border x:Name="EmptyPanel"
                        Background="#070B10"
                        Visibility="Visible">
                    <TextBlock x:Name="EmptyMsg"
                               Text="← Selecione um cliente"
                               FontSize="14"
                               Foreground="#162030"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Detalhe do cliente selecionado -->
                <DockPanel x:Name="DetailPanel"
                           Background="#070B10"
                           Visibility="Collapsed">

                    <!-- Header do cliente -->
                    <Border DockPanel.Dock="Top"
                            Background="#0B1018"
                            BorderBrush="#0D1825"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <!-- Barra de cor -->
                                <ColumnDefinition Width="*"/>
                                <!-- Info          -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Ações         -->
                            </Grid.ColumnDefinitions>

                            <!-- Barra de cor do cliente -->
                            <Border x:Name="ClientColorBar"
                                    Grid.Column="0"
                                    Background="#1A6CF5"/>

                            <!-- Info -->
                            <StackPanel Grid.Column="1"
                                        Margin="18,13,0,13"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="ClientNameText"
                                           Text=""
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#C8DCF0"/>
                                <TextBlock x:Name="ClientUrlText"
                                           Text=""
                                           FontSize="11"
                                           Foreground="#1A6CF5"
                                           Cursor="Hand"
                                           MouseLeftButtonUp="ClientUrl_Click"
                                           Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Ações -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,18,0">
                                <Button Content="✏  Editar"
                                        Style="{StaticResource GhostBtn}"
                                        Click="BtnEditClient_Click"
                                        Margin="0,0,6,0"/>
                                <Button Content="🗑"
                                        Style="{StaticResource DangerBtn}"
                                        Click="BtnDeleteClient_Click"
                                        Padding="8,5,8,5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tab bar -->
                    <Border DockPanel.Dock="Top"
                            Background="#0B1018"
                            BorderBrush="#0D1825"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabBtnCreds"
                                    Content="🔑  Credenciais"
                                    Style="{StaticResource TabBtnActive}"
                                    Click="Tab_Click" Tag="Credentials"/>
                            <Button x:Name="TabBtnLinks"
                                    Content="🌐  Links"
                                    Style="{StaticResource TabBtn}"
                                    Click="Tab_Click" Tag="Links"/>
                            <Button x:Name="TabBtnNotes"
                                    Content="📝  Observações"
                                    Style="{StaticResource TabBtn}"
                                    Click="Tab_Click" Tag="Notes"/>
                        </StackPanel>
                    </Border>

                    <!-- Tab: Credenciais ─────────────────────────────────── -->
                    <DockPanel x:Name="TabCredentials" Visibility="Visible">
                        <!-- Barra de ação -->
                        <Border DockPanel.Dock="Top"
                                Background="#0B1018"
                                BorderBrush="#0D1825"
                                BorderThickness="0,0,0,1"
                                Padding="22,10,22,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Credenciais salvas"
                                           FontSize="11" FontFamily="Segoe UI Semibold"
                                           Foreground="#2A3D52"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="➕  Adicionar"
                                        Style="{StaticResource GreenBtn}"
                                        Click="BtnAddCredential_Click"/>
                            </Grid>
                        </Border>

                        <!-- Lista de cards de credencial
                             Os cards são gerados em code-behind (BuildCredentialCard).
                             Cada card expõe:
                               • Campos copiáveis via CopyField() — label 100px, valor *
                               • Botão 📋 copiar para todos os campos (incluindo senha)
                               • Botão 👁 revelar para campos secret
                               • Feedback "✓" temporário ao copiar
                        -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Padding="22,12,22,22">
                            <StackPanel x:Name="CredentialListPanel"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Tab: Links ───────────────────────────────────────── -->
                    <DockPanel x:Name="TabLinks" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top"
                                Background="#0B1018"
                                BorderBrush="#0D1825"
                                BorderThickness="0,0,0,1"
                                Padding="22,10,22,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Ambientes e links"
                                           FontSize="11" FontFamily="Segoe UI Semibold"
                                           Foreground="#2A3D52"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="➕  Adicionar"
                                        Style="{StaticResource GreenBtn}"
                                        Click="BtnAddLink_Click"/>
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Padding="22,12,22,22">
                            <StackPanel x:Name="LinkListPanel"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Tab: Observações ─────────────────────────────────── -->
                    <DockPanel x:Name="TabNotes" Visibility="Collapsed" Margin="22">
                        <Button DockPanel.Dock="Bottom"
                                Content="💾  Salvar observações"
                                Style="{StaticResource PrimaryBtn}"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0"
                                Click="BtnSaveNotes_Click"/>
                        <TextBox x:Name="NotesBox"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Background="#0B1018"
                                 Foreground="#C8DCF0"
                                 BorderBrush="#0D1825"
                                 BorderThickness="1"
                                 FontSize="13" FontFamily="Segoe UI"
                                 Padding="14"
                                 VerticalScrollBarVisibility="Auto"
                                 CaretBrush="#1A6CF5"/>
                    </DockPanel>

                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
