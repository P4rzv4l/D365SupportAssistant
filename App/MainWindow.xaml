<Window x:Class="D365Assistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Painel de Atendimento"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="900"
        Background="#0D1117"
        WindowStyle="SingleBorderWindow"
        Closing="Window_Closing"
        Icon="/App/Assets/logo-roxo.ico">

    <Window.Resources>
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="16,10,16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#161B22"/>
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarBtnActive" TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
            <Setter Property="Background" Value="#1C2128"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#0D1117" BorderBrush="#21262D" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,20,16,16" BorderBrush="#21262D" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="{Binding UserName}" FontSize="16" FontWeight="Bold" Foreground="#E6EDF3" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Monitor de Chamados" FontSize="11" Foreground="#484F58" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Padding="16,10,16,10" BorderBrush="#21262D" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#484F58" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusText" Text="Iniciando..." FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="NextCycleText" Text="" FontSize="10" Foreground="#484F58"/>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top" Margin="8,8,8,0">
                    <Button x:Name="BtnDashboard" Tag="Dashboard" Style="{StaticResource SidebarBtnActive}" Click="NavBtn_Click" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="Incidents" Style="{StaticResource SidebarBtn}" Click="NavBtn_Click" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎫" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Chamados" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnTracker" Tag="Tracker" Style="{StaticResource SidebarBtn}" Click="NavBtn_Click" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Tracker" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="Alerts" Style="{StaticResource SidebarBtn}" Click="NavBtn_Click" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Alertas" VerticalAlignment="Center"/>
                            <Border x:Name="AlertBadge" Background="#F85149" CornerRadius="8" Padding="5,1,5,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="AlertBadgeCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAI" Tag="AI" Style="{StaticResource SidebarBtn}" Click="NavBtn_Click" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤖" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="IA (Gemini)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="Settings" Style="{StaticResource SidebarBtn}" Click="NavBtn_Click" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Configurações" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Padding="16,12,16,12" BorderBrush="#21262D" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="20" FontFamily="Consolas" FontWeight="Bold" Foreground="#E6EDF3" HorizontalAlignment="Center"/>
                </Border>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ÁREA PRINCIPAL -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" Background="#161B22" BorderBrush="#21262D" BorderThickness="0,1,0,0" Padding="16,6,16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusBarText" Grid.Column="0" Text="Pronto." FontSize="11" Foreground="#484F58" VerticalAlignment="Center"/>
                    <StackPanel x:Name="TimerStatusPanel" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="⏱ " FontSize="11" Foreground="#3FB950" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TimerTicketText" FontSize="11" FontWeight="SemiBold" Foreground="#3FB950" VerticalAlignment="Center"/>
                        <TextBlock Text="  " FontSize="11"/>
                        <TextBlock x:Name="TimerElapsedText" FontFamily="Consolas" FontSize="11" Foreground="#3FB950" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Background="#0D1117"/>
        </DockPanel>
    </Grid>
</Window>
